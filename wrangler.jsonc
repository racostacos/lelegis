{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lelegis",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "legis.le-comrade.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lelegis",
      "database_id": "09433f4c-b2c3-4aaf-b971-af13247f279d"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
